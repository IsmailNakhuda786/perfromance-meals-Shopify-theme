generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}
model Session {
  id String @id
  shop String
  state String
  isOnline Boolean @default(false)
  scope String?
  expires DateTime?
  accessToken String
  userId BigInt?
  firstName String?
  lastName String?
  email String?
  accountOwner Boolean @default(false)
  locale String?
  collaborator Boolean? @default(false)
  emailVerified Boolean? @default(false)
  refreshToken String?
  refreshTokenExpires DateTime?
}
model MealPlanDraft {
  id String @id @default(uuid())
  shop String
  customerGid String
  programmeGid String
  variantGid String
  sellingPlanGid String?
  startsOn String?
  endsOn String?
  selections String
  revision Int @default(1)
  updatedAt DateTime @updatedAt
  @@unique([shop, customerGid])
}
model MealPlanSelection {
  id String @id @default(uuid())
  shop String
  customerGid String
  programmeGid String
  variantGid String
  sellingPlanGid String?
  startsOn String?
  endsOn String?
  businessStream String @default("meal_plan")
  schemaVersion Int @default(1)
  entitlement String?
  selections String
  selectionHash String
  cutoffAt DateTime
  status String @default("REVIEWED")
  reviewedAt DateTime @default(now())
  orderGid String?
  orderLineGid String?
  contractGid String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([shop, customerGid])
  @@index([shop, orderGid])
}
model OperationalLine {
  id String @id @default(uuid())
  shop String
  orderGid String
  orderLineGid String
  customerGid String?
  productGid String?
  variantGid String?
  businessStream String?
  department String?
  validationStatus String
  validationReason String?
  selectionId String?
  contractGid String?
  bundleReviewId String?
  fulfillmentState String @default("UNASSIGNED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([shop, orderLineGid])
  @@index([shop, businessStream, validationStatus])
  @@index([shop, customerGid])
}
model WebhookReceipt {
  id String @id
  shop String
  topic String
  processedAt DateTime @default(now())
}
model PlanOperation {
  id String @id @default(uuid())
  shop String
  selectionId String
  kind String
  state String @default("REQUESTED")
  cycleReference String?
  deliveryAt DateTime?
  fulfillmentGid String?
  productionReference String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([shop, selectionId])
}
model MigrationMapping {
  id String @id @default(uuid())
  shop String
  sourceSystem String
  sourceType String
  sourceId String
  sourceCustomerId String?
  sourceSubscriptionId String?
  sourceOrderId String?
  targetGid String?
  appRecordId String?
  businessStream String
  state String @default("PENDING")
  migratedAt DateTime?
  historicalReference String?
  @@unique([shop, sourceSystem, sourceType, sourceId])
}

model CustomerWallet {
  id String @id @default(uuid())
  shop String
  customerGid String
  currency String
  fundedBalance Int @default(0)
  bonusBalance Int @default(0)
  fundedReserved Int @default(0)
  bonusReserved Int @default(0)
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([shop, customerGid, currency])
}
model WalletEntry {
  id String @id @default(uuid())
  shop String
  customerGid String
  currency String
  sourceEvent String
  sourceGid String?
  sourceKind String @default("legacy_unknown")
  nativeTransactionGid String?
  nativeSourceTransactionGid String?
  fundedAllocations String @default("[]")
  fundedDelta Int
  bonusDelta Int
  createdAt DateTime @default(now())
  @@unique([shop, sourceEvent])
  @@unique([shop, nativeTransactionGid])
  @@unique([shop, nativeSourceTransactionGid])
  @@index([shop, customerGid, currency])
}
model WalletReservation {
  id String @id @default(uuid())
  shop String
  customerGid String
  currency String
  checkoutReference String
  fundedMinor Int
  bonusMinor Int
  nativeLineSnapshot String
  state String @default("RESERVED")
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@unique([shop, checkoutReference])
  @@index([shop, customerGid, state])
}
model CommercePolicy {
  shop String @id
  walletEnabled Boolean @default(false)
  giftCardClaimsEnabled Boolean @default(false)
  walletTopUpsEnabled Boolean @default(false)
  orderCancellationsEnabled Boolean @default(false)
  rewardsEnabled Boolean @default(false)
  bonusTiers String?
  bonusExpiry String?
  refundRules String?
  referralRules String?
  giftCardRenewals Boolean?
  rewardsRules String?
  updatedAt DateTime @updatedAt
}

model OrderCancellation {
  id String @id @default(uuid())
  shop String
  orderGid String
  customerGid String
  currency String
  amountMinor Int
  contractGids String
  state String @default("PREPARED")
  jobGid String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([shop, orderGid])
  @@index([shop, customerGid, state])
}

model RewardsAccount {
  id String @id @default(uuid())
  shop String
  customerGid String
  points Int @default(0)
  lifetimeEarned Int @default(0)
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([shop, customerGid])
}

model RewardsEntry {
  id String @id @default(uuid())
  shop String
  customerGid String
  sourceEvent String
  orderGid String?
  rulesVersion String
  kind String
  pointsDelta Int
  createdAt DateTime @default(now())
  @@unique([shop, sourceEvent])
  @@index([shop, customerGid, createdAt])
}

model GiftCardWalletClaim {
  id String @id @default(uuid())
  shop String
  giftCardGid String
  customerGid String
  currency String
  giftCardExpiresOn String?
  amountMinor Int
  state String @default("PREPARED")
  debitGid String?
  creditGid String?
  ledgerEntryId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([shop, giftCardGid])
  @@unique([shop, debitGid])
  @@unique([shop, creditGid])
  @@index([shop, customerGid, state])
}

model WalletTopUpSettlement {
  id String @id @default(uuid())
  shop String
  orderGid String
  customerGid String
  currency String
  amountMinor Int
  paymentGid String
  state String @default("PREPARED")
  creditGid String?
  ledgerEntryId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([shop, orderGid])
  @@unique([shop, paymentGid])
  @@unique([shop, creditGid])
  @@index([shop, customerGid, state])
}

model WalletTopUpIntent {
  id String @id @default(uuid())
  shop String
  customerGid String
  requestKey String
  currency String
  amountMinor Int
  productGid String
  variantGid String
  state String @default("PREPARED")
  draftGid String?
  checkoutUrl String?
  orderGid String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([shop, customerGid, requestKey])
  @@unique([shop, draftGid])
  @@unique([shop, orderGid])
}

model MealPlanMenuRevision {
  id String @id @default(uuid())
  shop String
  customerGid String
  selectionId String
  block Int
  revision Int
  state String
  inputSelections String
  selections String
  cutoffAt DateTime
  createdAt DateTime @default(now())
  @@unique([shop, selectionId, block, revision])
  @@index([shop, customerGid, selectionId])
}

model RewardRedemption {
 id String @id @default(uuid())
 shop String
 customerGid String
 requestKey String
 rulesVersion String
 points Int
 amountMinor Int
 state String @default("PREPARED")
 nativeTransactionGid String?
 ledgerEntryId String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([shop, customerGid, requestKey])
 @@unique([shop, nativeTransactionGid])
 @@index([shop, customerGid, state])
}

model OrderSupportRequest {
 id String @id @default(uuid())
 shop String
 customerGid String
 orderGid String
 orderName String
 state String @default("REQUESTED")
 evidence String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([shop, orderGid])
 @@index([shop, customerGid, createdAt])
}

model RewardRuleVersion {
 id String @id @default(uuid())
 shop String
 version String
 rules String
 createdAt DateTime @default(now())
 @@unique([shop, version])
}

// Immutable record of when an approved rule version became active.
model RewardRuleActivation {
 id String @id @default(uuid())
 shop String
 rulesVersion String
 effectiveAt DateTime
 createdAt DateTime @default(now())
 @@unique([shop, effectiveAt])
}

// Native receipt-backed expiry metadata and reminder outbox only. These records
// never debit a Wallet, create credit or change a Shopify expiration date.
model WalletCreditExpiry {
  id String @id @default(uuid())
  shop String
  customerGid String
  currency String
  walletEntryId String
  nativeCreditGid String
  nativeAccountGid String
  sourceKind String
  amountMinor Int
  remainingMinor Int
  issuedAt DateTime
  expiresAt DateTime
  reminderAt DateTime
  observedAt DateTime
  enforcementMode String @default("NATIVE_OBSERVED")
  expiryState String @default("PENDING")
  expiredMinor Int @default(0)
  expiryAllocations String @default("[]")
  nativeExpiryDebitGid String? @unique
  expiryLedgerEntryId String?
  reminderState String @default("PENDING")
  deliveryKey String? @unique
  deliveryReference String?
  notifiedAt DateTime?
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([shop, walletEntryId])
  @@unique([shop, nativeCreditGid])
  @@index([shop, reminderState, reminderAt])
}

// Unclaimed Gift Card notifications only; never stores card codes or email addresses.
model GiftCardExpiryReminder {
  id String @id @default(uuid())
  shop String
  giftCardGid String
  customerGid String
  expiresOn String
  reminderAt DateTime
  remainingMinor Int
  state String @default("PENDING")
  deliveryKey String? @unique
  deliveryReference String?
  notifiedAt DateTime?
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([shop, giftCardGid])
  @@index([shop, state, reminderAt])
}


// Internal preparation only. No worker may send from a DRAFT delivery.
// Activation requires native paid-term/slot/fulfilment verification separately.
model ReadyDeliveryDraft {
 id String @id @default(uuid())
 shop String
 customerGid String
 operationalLineId String
 occurrence Int
 deliveryAt DateTime
 revision Int @default(1)
 state String @default("DRAFT")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([shop, operationalLineId, occurrence])
 @@index([shop, customerGid])
}
model ReadyDeliveryReminder {
 id String @id @default(uuid())
 shop String
 customerGid String
 deliveryDraftId String
 deliveryRevision Int
 channel String
 hoursBefore Int
 scheduledAt DateTime
 deliveryAt DateTime
 state String @default("DRAFT")
 deliveryKey String @unique
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([shop, deliveryDraftId, deliveryRevision, channel, hoursBefore], map: "ReadyDeliveryReminder_occurrence_revision_channel_lead_key")
 @@index([shop, state, scheduledAt])
}

// Internal immutable checkout review; no public checkout activation yet.
model BundlePurchaseReview {
 id String @id @default(uuid())
 shop String
 customerGid String
 productGid String
 variantGid String
 currency String
 quantity Int
 snapshot String
 snapshotHash String
 state String @default("REVIEWED")
 reviewedAt DateTime @default(now())
 orderGid String?
 orderLineGid String?
 createdAt DateTime @default(now())
 @@unique([shop, orderLineGid])
 @@index([shop, customerGid, state])
}

// Provider-neutral saved drafts only: not credit lots, reservations or settlement.
model CoreWalletRedemptionDraft {
 id String @id @default(uuid())
 shop String
 customerGid String
 currency String
 attemptId String
 state String
 revision Int
 payload String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([shop, attemptId])
 @@index([shop, customerGid, state])
}

// Audited future-billing stop only. Paid-order/delivery/Wallet state is separate.
model SubscriptionRenewalStop {
 id String @id @default(uuid())
 shop String
 customerGid String
 contractGid String
 originOrderGid String
 bindingHash String
 requestKey String
 state String @default("REQUESTING")
 requestedAt DateTime @default(now())
 confirmedAt DateTime?
 updatedAt DateTime @updatedAt
 @@unique([shop, contractGid])
 @@index([shop, customerGid, state])
}

// Immutable paid-purchase proof. Development-only until native lifecycle acceptance.
model PrepaidPurchaseEvidence {
 id String @id @default(cuid())
 shop String
 customerGid String
 contractGid String
 originalOrderGid String
 originalLineGid String
 snapshot String
 snapshotHash String
 createdAt DateTime @default(now())
 @@unique([shop, contractGid])
 @@unique([shop, originalLineGid])
 @@index([shop, customerGid])
}

// A verified successful native attempt, never authorization to create a charge.
model PrepaidRenewalEvidence {
 id String @id @default(cuid())
 shop String
 customerGid String
 contractGid String
 purchaseEvidenceId String
 attemptGid String
 renewalOrderGid String
 snapshot String
 snapshotHash String
 state String @default("PENDING_LINK")
 createdAt DateTime @default(now())
 completedAt DateTime?
 @@unique([shop, attemptGid])
 @@unique([shop, renewalOrderGid])
 @@index([shop, customerGid])
 @@index([shop, state, createdAt, id])
}

// Minimal authenticated trigger; no payment/entitlement is inferred at intake.
model PrepaidRenewalInbox {
 id String @id @default(cuid())
 shop String
 customerGid String
 purchaseEvidenceId String
 contractGid String
 attemptGid String
 idempotencyKey String
 renewalOrderGid String
 state String @default("PENDING_VERIFY")
 createdAt DateTime @default(now())
 completedAt DateTime?
 @@unique([shop, attemptGid])
 @@index([shop, customerGid])
 @@index([shop, state, createdAt, id])
}
