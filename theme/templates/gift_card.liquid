{% layout none %}
<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex">{{ content_for_header }}<title>{{ 'gift.performance' | t }} — {{ shop.name }}</title>{{ 'theme.css' | asset_url | stylesheet_tag }}</head><body class="bg-[#F7F5F0] font-body min-h-screen flex items-center justify-center px-6 py-16"><main class="w-full max-w-[560px] text-center"><h1 class="font-display text-[40px] font-bold mb-6">{{ 'gift.performance' | t }}</h1><div class="bg-[#111] text-white p-8 text-left relative overflow-hidden">{% render 'logos', brand: 'pm', size: 'md', variant: 'light' %}<p class="font-display text-[48px] font-extrabold text-[#F5B300] my-6">{{ gift_card.balance | money_with_currency }}</p><p class="text-white/45 text-[12px] mb-5">{{ 'gift.balance' | t }}</p><code class="block border border-white/15 px-4 py-3 font-mono text-[#F5B300] break-all text-[20px]">{{ gift_card.code | format_code }}</code>{% if gift_card.recipient %}<p class="mt-5">{{ gift_card.recipient.name | default: gift_card.recipient.email | escape }}</p>{% endif %}{% if gift_card.message %}<p class="italic text-white/60 mt-3">{{ gift_card.message | escape }}</p>{% endif %}{% if gift_card.send_on %}<p class="text-white/45 text-[12px] mt-4">{{ 'gift.send_on' | t }}: {{ gift_card.send_on | date: '%d %B %Y' }}</p>{% endif %}{% if gift_card.expired %}<p class="text-red-300 mt-4">{{ 'gift.expired' | t }}</p>{% elsif gift_card.expires_on %}<p class="text-white/45 mt-4">{{ 'gift.expires' | t: date: gift_card.expires_on }}</p>{% endif %}{% if gift_card.enabled == false %}<p class="text-red-300 mt-4">{{ 'gift.disabled' | t }}</p>{% endif %}</div><a class="pm-button mt-8" href="{{ shop.url }}">{{ 'gift.shop' | t }}</a>{% if gift_card.pass_url %}<a class="block underline mt-5" href="{{ gift_card.pass_url }}">{{ 'gift.wallet' | t }}</a>{% endif %}</main></body></html>
