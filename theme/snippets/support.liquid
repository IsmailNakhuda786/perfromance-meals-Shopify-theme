{% doc %}
Renders the approved floating WhatsApp support with a merchant verified destination.
@param {string} [number] - Verified international WhatsApp number, including country code.
@param {string} [prefix] - Message prefix for the quick topics.
{% enddoc %}
{% liquid
  assign support_number = number | default: settings.whatsapp_number | strip | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '.'
  assign message_prefix = prefix | default: settings.whatsapp_message_prefix
  if message_prefix == blank
    assign message_prefix = 'support.message_prefix' | t
  endif
  assign order_message = 'support.order_message' | t
  assign meal_plan_message = 'support.meal_plan_message' | t
  assign ready_series_message = 'support.ready_series_message' | t
  assign delivery_message = 'support.delivery_message' | t
%}
{% if support_number != blank %}
<details class="pm-support fixed bottom-6 right-6 z-50" data-support>
  <summary class="pm-support-toggle w-14 h-14 flex items-center justify-center transition-colors cursor-pointer list-none" aria-label="{{ 'support.open' | t }}" data-support-open-label="{{ 'support.open' | t }}" data-support-close-label="{{ 'support.close' | t }}" aria-controls="SupportPanel">
    <svg class="pm-support-open-icon" width="26" height="26" viewBox="0 0 24 24" fill="white" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M11.99 2C6.476 2 2 6.476 2 11.99c0 1.77.463 3.433 1.27 4.88L2 22l5.287-1.384A9.942 9.942 0 0011.99 22c5.514 0 9.99-4.476 9.99-9.99S17.504 2 11.99 2zm0 18.18a8.17 8.17 0 01-4.164-1.135l-.299-.178-3.138.822.836-3.053-.194-.312A8.183 8.183 0 013.82 11.99 8.17 8.17 0 0111.99 3.82 8.17 8.17 0 0120.16 11.99a8.17 8.17 0 01-8.17 8.19z"/></svg>
    <svg class="pm-support-close-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
  </summary>
  <div id="SupportPanel" class="pm-support-panel bg-white border border-[#E8E4DC] overflow-hidden" role="region" aria-label="{{ 'support.open' | t }}">
    <div class="px-5 py-4 flex items-center justify-between" style="background:#075E54"><div class="flex items-center gap-3"><span class="w-9 h-9 bg-white flex items-center justify-center shrink-0" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="#25D366"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M11.99 2C6.476 2 2 6.476 2 11.99c0 1.77.463 3.433 1.27 4.88L2 22l5.287-1.384A9.942 9.942 0 0011.99 22c5.514 0 9.99-4.476 9.99-9.99S17.504 2 11.99 2zm0 18.18a8.17 8.17 0 01-4.164-1.135l-.299-.178-3.138.822.836-3.053-.194-.312A8.183 8.183 0 013.82 11.99 8.17 8.17 0 0111.99 3.82 8.17 8.17 0 0120.16 11.99a8.17 8.17 0 01-8.17 8.19z"/></svg></span><span><span class="block text-white text-[13px] font-semibold">{{ 'support.title' | t }}</span><span class="block text-white/70 text-[10px] mt-0.5">{{ 'support.channel' | t }}</span></span></div><button type="button" data-support-close class="text-white/50 hover:text-white transition-colors p-1" aria-label="{{ 'support.close' | t }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button></div>
    <div class="bg-[#ECE5DD] px-5 py-5"><div class="bg-white px-4 py-3 max-w-[240px] shadow-sm mb-2" style="border-radius:0 8px 8px 8px"><p class="text-[13px] text-[#1A1A1A] leading-relaxed">{{ 'support.greeting' | t }}</p></div><div class="bg-white px-4 py-3 max-w-[240px] shadow-sm" style="border-radius:0 8px 8px 8px"><p class="text-[13px] text-[#1A1A1A] leading-relaxed">{{ 'support.question' | t }}</p></div></div>
    <div class="px-5 py-4 bg-white border-t border-[#E8E4DC]"><p class="text-[10px] font-semibold tracking-[0.15em] uppercase text-[#aaa] mb-3">{{ 'support.topics' | t }}</p><div class="flex flex-col gap-2">
      <a href="https://wa.me/{{ support_number }}?text={{ message_prefix | append: order_message | url_encode }}" target="_blank" rel="noopener noreferrer" data-support-topic class="pm-support-topic w-full text-left px-3 py-2.5 border border-[#E8E4DC] text-[#333] hover:border-[#25D366] text-[12px] font-medium transition-all flex items-center justify-between">{{ 'support.track_order' | t }}<span aria-hidden="true">→</span></a>
      <a href="https://wa.me/{{ support_number }}?text={{ message_prefix | append: meal_plan_message | url_encode }}" target="_blank" rel="noopener noreferrer" data-support-topic class="pm-support-topic w-full text-left px-3 py-2.5 border border-[#E8E4DC] text-[#333] hover:border-[#25D366] text-[12px] font-medium transition-all flex items-center justify-between">{{ 'support.meal_plan' | t }}<span aria-hidden="true">→</span></a>
      <a href="https://wa.me/{{ support_number }}?text={{ message_prefix | append: ready_series_message | url_encode }}" target="_blank" rel="noopener noreferrer" data-support-topic class="pm-support-topic w-full text-left px-3 py-2.5 border border-[#E8E4DC] text-[#333] hover:border-[#25D366] text-[12px] font-medium transition-all flex items-center justify-between">{{ 'support.ready_series' | t }}<span aria-hidden="true">→</span></a>
      <a href="https://wa.me/{{ support_number }}?text={{ message_prefix | append: delivery_message | url_encode }}" target="_blank" rel="noopener noreferrer" data-support-topic class="pm-support-topic w-full text-left px-3 py-2.5 border border-[#E8E4DC] text-[#333] hover:border-[#25D366] text-[12px] font-medium transition-all flex items-center justify-between">{{ 'support.delivery' | t }}<span aria-hidden="true">→</span></a>
    </div><a href="https://wa.me/{{ support_number }}" target="_blank" rel="noopener noreferrer" class="mt-3 flex items-center justify-center gap-2 w-full py-3 text-white text-[12px] font-bold tracking-[0.1em] uppercase transition-colors" style="background:#25D366">{{ 'support.open_whatsapp' | t }}<span aria-hidden="true">→</span></a></div>
  </div>
</details>
{% endif %}
{% stylesheet %}
.pm-support-toggle{background:#25d366;box-shadow:0 4px 20px #0003}.pm-support-toggle::-webkit-details-marker{display:none}.pm-support[open] .pm-support-toggle{background:#1a1a1a}.pm-support-close-icon{display:none}.pm-support[open] .pm-support-close-icon{display:block}.pm-support[open] .pm-support-open-icon{display:none}.pm-support-panel{position:absolute;bottom:calc(100% + 12px);right:0;width:300px;max-width:calc(100vw - 48px);max-height:calc(100dvh - 112px);overflow-y:auto;box-shadow:0 8px 40px #00000024}.pm-support-topic.is-selected{border-color:#25d366;background:#25d3660d;color:#075e54}@media(min-width:640px){.pm-support-panel{width:340px}}
{% endstylesheet %}
