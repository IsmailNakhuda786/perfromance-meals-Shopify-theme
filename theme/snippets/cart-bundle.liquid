{% doc %}
Renders the approved bundle drawer presentation from native cart and contents.
@param {line_item} item - Shopify cart line
@param contents - Bundle content metaobjects
{% enddoc %}
{% assign meal_count = item.variant.metafields.performance.meal_count.value | default: item.product.metafields.performance.meal_count.value %}
<div class="pm-cart-bundle-header">
  <div>
    <a href="{{ item.url }}" class="pm-cart-bundle-title">{{ item.product.title | escape }}{% unless item.variant.title == 'Default Title' or item.product.title contains item.variant.title %} — {{ item.variant.title | escape }}{% endunless %}</a>
    {% if meal_count > 0 %}<p class="pm-cart-bundle-unit">{{ item.final_line_price | divided_by: item.quantity | divided_by: meal_count | round | money }}{{ 'cart.per_meal' | t }}</p>{% endif %}
  </div>
  <div class="pm-cart-bundle-price"><strong>{{ item.final_line_price | money }}</strong><a href="{{ item.url_to_remove }}" data-cart-remove data-key="{{ item.key | escape }}" aria-label="{{ 'cart.remove_product' | t: product: item.product.title | escape }}"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></a></div>
</div>
<input type="hidden" name="updates[]" value="{{ item.quantity }}">
{% assign shown = 0 %}
<div class="pm-bundle-thumbnails flex gap-1 mt-2">
  {% for part in contents %}{% assign meal = part.variant.value.product | default: part.product.value %}{% assign part_quantity = part.quantity.value %}{% for unit in (1..part_quantity) %}{% if shown >= 5 %}{% break %}{% endif %}{% if meal.featured_image %}{{ meal.featured_image | image_url: width: 120 | image_tag: width: 36, height: 36, loading: 'lazy', class: 'w-9 h-9 object-cover' }}{% endif %}{% assign shown = shown | plus: 1 %}{% endfor %}{% endfor %}
  {% if meal_count > 5 %}<span class="pm-cart-bundle-more">+{{ meal_count | minus: 5 }}</span>{% endif %}
</div>
<details class="pm-cart-bundle-details"><summary><span class="pm-bundle-see">{{ 'cart.see_meals' | t }}</span><span class="pm-bundle-hide">{{ 'cart.hide_meals' | t }}</span></summary><ul>{% for part in contents %}{% assign meal = part.variant.value.product | default: part.product.value %}{% if meal %}<li>{% if meal.featured_image %}{{ meal.featured_image | image_url: width: 100 | image_tag: width: 32, height: 32, loading: 'lazy' }}{% endif %}<span>{{ meal.title | escape }}</span><b>×{{ part.quantity.value }}</b></li>{% endif %}{% endfor %}</ul></details>
{% if item.selling_plan_allocation %}<p class="text-[11px] text-[#F5B300] mt-1">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}
{% for property in item.properties %}{% assign first_character = property.first | slice: 0 %}{% if property.last != blank and first_character != '_' %}<p class="text-[10px] text-white/45 mt-1 break-words">{{ property.first | escape }}: {{ property.last | escape }}</p>{% endif %}{% endfor %}
