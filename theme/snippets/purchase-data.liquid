{% doc %}
  Emits script-safe native variant and recurring allocation data for one purchase context.
  @param {product} product - Shopify product.
  @param {string} purchase_mode - single, bundles, or subscription.
  @param {boolean} [require_account] - Require real customer sign-in for subscription presentation.
  @example
  {% render 'purchase-data', product: product, purchase_mode: 'subscription' %}
{% enddoc %}
<script type="application/json" data-variants>
{
  "currency":{{ cart.currency.iso_code | default: shop.currency | json }},
  "locale":{{ request.locale.iso_code | json }},
  "purchaseMode":{{ purchase_mode | json | replace: '<', '\u003c' }},
  "prepaidTermRequired":{% if product.metafields.performance.business_stream.value == 'ready_series' %}true{% else %}false{% endif %},
  "prepaidTermVerified":{% if product.metafields.performance.prepaid_term_verified.value == true %}true{% else %}false{% endif %},
  "requiresSellingPlan":{{ product.requires_selling_plan | json }},
  "hasContents":{% if product.metafields.performance.bundle_contents != blank %}true{% else %}false{% endif %},
  "requireAccount":{% if require_account or purchase_mode == 'bundles' and product.metafields.performance.business_stream.value == 'ready_series' %}true{% else %}false{% endif %},
  "loggedIn":{% if customer %}true{% else %}false{% endif %},
  "loginUrl":{% if purchase_mode == 'bundles' %}{{ routes.storefront_login_url | json | replace: '<', '\u003c' }}{% else %}{{ routes.account_login_url | json | replace: '<', '\u003c' }}{% endif %},
  "productUrl":{{ product.url | json | replace: '<', '\u003c' }},
  "unavailablePrice":{{ 'catalog.subscription_unavailable' | t | json | replace: '<', '\u003c' }},
  "variants":[
    {% for item in product.variants %}
      {
        "id":{{ item.id | json }},
        {% assign variant_contents = item.metafields.performance.bundle_contents.value | default: product.metafields.performance.bundle_contents.value %}
        "hasContents":{% if variant_contents != blank %}true{% else %}false{% endif %},
        "contents":[{% for component in variant_contents %}{% assign included_product = component.variant.value.product | default: component.product.value %}{"name":{{ included_product.title | json | replace: '<', '\u003c' }},"quantity":{{ component.quantity.value | json }},"url":{{ included_product.url | json }},"image":{% if included_product.featured_image %}{{ included_product.featured_image | image_url: width: 600 | json }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}],
        "highlights":{{ item.metafields.performance.highlights.value | default: product.metafields.performance.highlights.value | default: nil | json | replace: '<', '\u003c' }},
        "available":{{ item.available | json }},
        "requiresSellingPlan":{{ item.requires_selling_plan | json }},
        "price":{{ item.price | money_with_currency | strip_html | json | replace: '<', '\u003c' }},
        "priceAmount":{{ item.price | json }},
        "perMealPrice":{% if product.metafields.performance.meal_count.value > 0 %}{{ item.price | divided_by: product.metafields.performance.meal_count.value | round | money_with_currency | strip_html | json | replace: '<', '\u003c' }}{% else %}null{% endif %},
        "comparePrice":{% if item.compare_at_price > item.price %}{{ item.compare_at_price | money_with_currency | strip_html | json | replace: '<', '\u003c' }}{% else %}""{% endif %},
        "image":{% if item.featured_image %}{{ item.featured_image | image_url: width: 1600 | json | replace: '<', '\u003c' }}{% else %}null{% endif %},
        "quantityMin":{{ item.quantity_rule.min | default: 1 | json }},
        "quantityMax":{{ item.quantity_rule.max | json }},
        "quantityStep":{{ item.quantity_rule.increment | default: 1 | json }},
        "plans":[
          {% for allocation in item.selling_plan_allocations %}
            {
              "id":{{ allocation.selling_plan.id | json }},
              "name":{{ allocation.selling_plan.name | json | replace: '<', '\u003c' }},
              "recurring":{{ allocation.selling_plan.recurring_deliveries | json }},
              "description":{{ allocation.selling_plan.description | strip_html | json | replace: '<', '\u003c' }},
              "price":{{ allocation.price | money_with_currency | strip_html | json | replace: '<', '\u003c' }},
              "priceAmount":{{ allocation.price | json }},
              "deliveryPrice":{{ allocation.per_delivery_price | money_with_currency | strip_html | json | replace: '<', '\u003c' }},
              "perMealPrice":{% if product.metafields.performance.meal_count.value > 0 %}{{ allocation.per_delivery_price | divided_by: product.metafields.performance.meal_count.value | round | money_with_currency | strip_html | json | replace: '<', '\u003c' }}{% else %}null{% endif %},
              "comparePrice":{% if allocation.compare_at_price > allocation.price %}{{ allocation.compare_at_price | money_with_currency | strip_html | json | replace: '<', '\u003c' }}{% else %}""{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
</script>
