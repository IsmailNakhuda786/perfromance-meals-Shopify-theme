<footer class="bg-[#1A1A1A] border-t border-white/5">
  <div class="max-w-[1440px] mx-auto px-6 py-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-8"><a href="{{ routes.root_url }}" class="shrink-0">{% render 'logos', brand: 'pm', size: 'sm', variant: 'light' %}</a>
    <nav class="flex flex-wrap gap-x-7 gap-y-2" aria-label="{{ 'navigation.footer' | t }}"><a href="{{ section.settings.ready_series_url | default: '/pages/ready-series' }}" class="text-[11px] sm:text-[12px] text-white/60 hover:text-[#F5B300] transition-colors tracking-wide whitespace-nowrap">{{ 'navigation.footer_ready_series' | t }}</a><a href="{{ section.settings.meal_plan_url | default: '/pages/meal-plan' }}" class="text-[11px] sm:text-[12px] text-white/60 hover:text-[#F5B300] transition-colors tracking-wide whitespace-nowrap">{{ 'navigation.footer_meal_plans' | t }}</a><a href="{{ section.settings.gift_card_url | default: '/pages/gift-card' }}" class="text-[11px] sm:text-[12px] text-white/60 hover:text-[#F5B300] transition-colors tracking-wide whitespace-nowrap">{{ 'navigation.gift_cards' | t }}</a><a href="{{ section.settings.about_url | default: '/pages/about' }}" class="text-[11px] sm:text-[12px] text-white/60 hover:text-[#F5B300] transition-colors tracking-wide whitespace-nowrap">{{ 'navigation.about' | t }}</a></nav>
    {% if section.settings.email != blank or section.settings.contact != blank %}<div class="text-[11px] text-white/30 text-right shrink-0 hidden lg:block">{% if section.settings.email != blank %}<a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a>{% endif %}<div class="mt-0.5">{{ section.settings.contact | escape }}</div></div>{% endif %}
  </div>
  <div class="border-t border-white/5"><div class="max-w-[1440px] mx-auto px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-3 text-[11px] text-white/30"><span>© {{ 'now' | date: '%Y' }} {{ section.settings.company_name | default: shop.name | escape }}{% if section.settings.registration != blank %} · {{ section.settings.registration | escape }}{% endif %}</span><div class="flex gap-5 items-center">{% if shop.privacy_policy != blank %}<a href="{{ shop.privacy_policy.url }}" class="hover:text-white/70 transition-colors">{{ 'navigation.privacy' | t }}</a>{% endif %}{% if shop.terms_of_service != blank %}<a href="{{ shop.terms_of_service.url }}" class="hover:text-white/70 transition-colors">{{ 'navigation.terms' | t }}</a>{% endif %}{% if shop.refund_policy != blank %}<a href="{{ shop.refund_policy.url }}" class="hover:text-white/70 transition-colors">{{ 'navigation.refunds' | t }}</a>{% endif %}</div></div></div>
</footer>

{% schema %}
{
  "name": "Performance Meals footer",
  "settings": [
    {
      "type": "url",
      "id": "ready_series_url",
      "label": "Ready Series Url"
    },
    {
      "type": "url",
      "id": "meal_plan_url",
      "label": "Meal Plan Url"
    },
    {
      "type": "url",
      "id": "gift_card_url",
      "label": "Gift Cards URL"
    },
    {
      "type": "url",
      "id": "about_url",
      "label": "About Url"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Additional footer menu"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email"
    },
    {
      "type": "text",
      "id": "contact",
      "label": "Verified phone and location"
    },
    {
      "type": "text",
      "id": "company_name",
      "label": "Company Name",
      "default": "Performance Meals Pte. Ltd."
    },
    {
      "type": "text",
      "id": "registration",
      "label": "Verified company registration"
    }
  ],
  "presets": [
    {
      "name": "Performance Meals footer"
    }
  ]
}
{% endschema %}
