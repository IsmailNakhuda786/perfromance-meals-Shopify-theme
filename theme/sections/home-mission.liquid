<section class="bg-white overflow-hidden"><div class="flex flex-col lg:flex-row">
  <div class="lg:w-[47%] flex-shrink-0 relative" style="min-height:280px">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1800 | image_tag: class: 'w-full h-full object-cover absolute inset-0', loading: 'lazy', sizes: '(min-width: 1024px) 55vw, 100vw' }}{% else %}<img src="{{ '13da6.png' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" width="1200" height="800" loading="lazy" class="w-full h-full object-cover absolute inset-0">{% endif %}</div><div class="hidden lg:block w-5 flex-shrink-0 bg-[#F5B300]"></div>
  <div class="flex-1 px-6 sm:px-10 lg:px-14 py-10 sm:py-14 lg:py-20 flex flex-col justify-center">
    <div class="flex items-baseline gap-5 mb-6"><span class="font-display font-bold text-[#F5B300]" style="font-size:clamp(36px,4vw,52px);line-height:1;letter-spacing:-.03em">{{ section.settings.number | escape }}</span><span class="text-[#1A1A1A] text-[11px] font-medium tracking-[0.05em]">{{ section.settings.eyebrow | escape }}</span></div>
    <h2 class="font-display font-bold text-[#1A1A1A] mb-8" style="font-size:clamp(36px,4.5vw,56px);line-height:.92;letter-spacing:-.022em">{{ section.settings.heading | escape | newline_to_br }}</h2><p class="text-[#7A7A75] leading-[1.5] mb-8 max-w-[500px]" style="font-size:clamp(14px,1.5vw,17px)">{{ section.settings.body | escape }}</p><div class="h-px bg-[#1A1A1A]/13 w-full max-w-[510px] mb-7"></div><p class="text-[#F5B300] text-[11px] font-medium tracking-[0.04em] mb-4">{{ section.settings.mission_label | escape }}</p><p class="text-[#1A1A1A] leading-[1.3] max-w-[500px] font-display" style="font-size:20px;font-weight:500;letter-spacing:-.003em">{{ section.settings.mission | escape }}</p>
  </div>
</div></section>

{% schema %}
{
  "name": "Food first mission",
  "settings": [
    {
      "type": "text",
      "id": "number",
      "label": "Number",
      "default": "04"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FOOD FIRST. PERFORMANCE FOLLOWS."
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "CONVENIENCE\nWITHOUT\nCOMPROMISE."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Convenient food should still respect the ingredients, the craft and the person eating it. That principle shapes every Performance Meals experience."
    },
    {
      "type": "text",
      "id": "mission_label",
      "label": "Mission Label",
      "default": "OUR MISSION"
    },
    {
      "type": "textarea",
      "id": "mission",
      "label": "Mission",
      "default": "To deliver exceptional meals and thoughtful support that make healthy eating easier every day."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image Alt",
      "default": "Performance Meals food"
    }
  ],
  "presets": [
    {
      "name": "Food first mission"
    }
  ]
}
{% endschema %}
