{% liquid
  assign gift_product = section.settings.product
  if product != blank and product.gift_card?
    assign gift_product = product
  endif
  assign gift_variant = gift_product.selected_or_first_available_variant
  assign gift_options = gift_product.variants | sort: 'price'
  assign default_amount = section.settings.default_amount | times: 100
  if gift_product.selected_variant == blank
    for option in gift_options
      if option.price == default_amount and option.available
        assign gift_variant = option
        break
      endif
    endfor
  endif
  assign form_id = 'GiftForm-' | append: section.id
%}
<section class="min-h-screen bg-[#F7F5F0]" data-gift-section>
  <div class="bg-white border-b border-[#E5E2DA] px-6 py-4 flex items-center justify-between"><a href="{{ routes.root_url }}" class="w-[132px] shrink-0">{% render 'logos', brand: 'pm', size: 'sm', variant: 'dark' %}</a><div class="flex items-center gap-2 sm:gap-3 text-[11px] uppercase tracking-wider shrink-0"><span class="w-7 h-7 rounded-full flex items-center justify-center bg-[#111] text-white">1</span><span class="hidden sm:inline">{{ 'gift.details' | t }}</span><span class="w-8 h-px bg-[#E5E2DA]"></span><span class="w-7 h-7 rounded-full border-2 border-[#D0CCC4] flex items-center justify-center text-[#aaa]">2</span><span class="hidden sm:inline">{{ 'gift.checkout' | t }}</span></div><a href="{{ routes.root_url }}" aria-label="{{ 'general.close' | t | escape }}" class="text-[#aaa] hover:text-[#111] text-[13px] transition-colors">✕</a></div>
  <div class="max-w-[1080px] mx-auto px-4 sm:px-6 py-8 sm:py-12 grid grid-cols-1 lg:grid-cols-5 gap-10">
    <div class="lg:col-span-3">
      <h1 class="font-display text-[36px] font-bold text-black mb-2">{{ section.settings.heading | escape }}</h1><p class="text-[#666] text-[15px] mb-8">{{ section.settings.copy | escape }}</p>
      {% if gift_product != blank and gift_product.gift_card? %}
        {% form 'product', gift_product, id: form_id, data-product-form: '' %}
          {% render 'business-stream-properties', product: gift_product %}
          {{ form.errors | default_errors }}
          <input type="hidden" name="quantity" value="1">
          <fieldset class="mb-8"><legend class="text-[11px] font-mono tracking-[0.2em] uppercase text-[#888] mb-3">{{ 'gift.choose_amount' | t }}</legend><div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            {% for gift_option in gift_options %}<label class="relative cursor-pointer"><input class="peer sr-only" type="radio" name="id" value="{{ gift_option.id }}" data-gift-variant data-price="{{ gift_option.price | money_with_currency | escape }}"{% if gift_option.id == gift_variant.id %} checked{% endif %}{% unless gift_option.available %} disabled{% endunless %}><span class="block py-4 text-center border-2 transition-all font-display text-[22px] font-bold border-[#D0CCC4] bg-white text-[#888] peer-checked:border-[#F5B300] peer-checked:text-[#111] peer-focus-visible:outline-2 peer-disabled:opacity-35">{{ gift_option.price | money_without_trailing_zeros }}<span class="block text-[9px] font-body opacity-0 peer-checked:opacity-100 pm-gift-selected">{{ 'sync.selected' | t }}</span>{% unless gift_option.available %}<span class="block text-[10px] font-body">{{ 'catalog.sold_out' | t }}</span>{% endunless %}</span></label>{% endfor %}
          </div></fieldset>
          <input type="hidden" name="properties[__shopify_send_gift_card_to_recipient]" value="true">
          <input type="hidden" name="properties[__shopify_offset]" data-gift-offset value="">
          <fieldset class="mb-8"><legend class="text-[11px] font-mono tracking-[0.2em] uppercase text-[#888] mb-3">{{ 'gift.recipient' | t }}</legend><div class="space-y-3"><label class="sr-only" for="{{ form_id }}-name">{{ 'gift.recipient_name' | t }}</label><input id="{{ form_id }}-name" name="properties[Recipient name]" type="text" maxlength="255" autocomplete="off" data-gift-name placeholder="{{ 'gift.recipient_name' | t | escape }}" class="pm-gift-input"><label class="sr-only" for="{{ form_id }}-email">{{ 'gift.recipient_email' | t }}</label><input id="{{ form_id }}-email" name="properties[Recipient email]" type="email" required autocomplete="off" value="{{ form.email }}" placeholder="{{ 'gift.recipient_email' | t | escape }} *" class="pm-gift-input"></div></fieldset>
          <fieldset class="mb-8"><legend class="text-[11px] font-mono tracking-[0.2em] uppercase text-[#888] mb-3">{{ 'gift.from_you' | t }}</legend><div class="space-y-3"><label for="{{ form_id }}-sender" class="sr-only">{{ 'gift.sender_name' | t }}</label><input id="{{ form_id }}-sender" name="properties[From]" type="text" maxlength="255" required autocomplete="name" placeholder="{{ 'gift.sender_name' | t | escape }} *" class="pm-gift-input"><label for="{{ form_id }}-message" class="sr-only">{{ 'gift.message' | t }}</label><textarea id="{{ form_id }}-message" name="properties[Message]" data-gift-message maxlength="200" rows="3" placeholder="{{ 'gift.message' | t | escape }}" class="pm-gift-input resize-none">{{ form.message }}</textarea></div></fieldset>
          <fieldset class="mb-10"><legend class="text-[11px] font-mono tracking-[0.2em] uppercase text-[#888] mb-3">{{ 'gift.delivery' | t }}</legend><div class="py-4 px-5 border-2 border-[#111] bg-[#111] text-white"><div class="font-medium text-[14px]">{{ 'gift.email_delivery' | t }}</div><p class="text-[12px] mt-1 text-white/60">{{ 'gift.delivery_copy' | t }}</p></div><label class="sr-only" for="{{ form_id }}-send">{{ 'gift.send_on' | t }}</label><input id="{{ form_id }}-send" type="date" name="properties[Send on]" data-gift-date hidden class="pm-gift-input mt-2"></fieldset>
          <p data-form-error role="alert" class="text-red-700 text-[12px] mb-3" hidden></p><button type="submit" class="w-full py-4 text-[13px] font-bold tracking-[0.15em] uppercase bg-[#F5B300] text-[#111] hover:bg-[#111] hover:text-white transition-colors"{% unless gift_variant.available %} disabled{% endunless %}>{{ 'gift.add' | t }} →</button>
        {% endform %}
      {% else %}<p class="bg-white border border-[#E5E2DA] px-5 py-6 text-[#666]">{{ 'gift.unavailable' | t }}</p>{% endif %}
      {% for block in section.blocks %}{% render block %}{% endfor %}
    </div>
    <aside class="lg:col-span-2"><div class="bg-white border border-[#E5E2DA] p-6 sticky top-4">
      <p class="font-mono text-[10px] tracking-[0.3em] text-[#999] uppercase mb-4">{{ 'gift.summary' | t }}</p><div class="bg-[#111] text-white p-5 mb-5 relative overflow-hidden"><div class="absolute top-0 right-0 w-32 h-32 bg-[#F5B300]/10 rounded-full -translate-y-8 translate-x-8"></div><div class="relative"><div class="mb-5">{% render 'logos', brand: 'pm', size: 'sm', variant: 'light' %}</div><p class="font-mono text-[10px] tracking-[0.3em] text-white/40 uppercase mb-6">{{ 'gift.performance' | t }}</p><strong data-gift-value class="font-display block text-[36px] font-bold text-[#F5B300] mb-1">{% if gift_variant %}{{ gift_variant.price | money_with_currency }}{% endif %}</strong><p class="text-white/40 text-[13px] mb-6">{{ 'gift.value' | t }}</p><p data-gift-recipient-preview class="text-white/40 text-[12px] mt-4"></p><p data-gift-message-preview class="text-white/50 text-[13px] italic mt-2 break-words"></p></div></div><dl class="space-y-2 text-[13px] border-t border-[#E5E2DA] pt-4"><div class="flex justify-between"><dt class="text-[#888]">{{ 'gift.value' | t }}</dt><dd data-gift-value>{{ gift_variant.price | money_with_currency }}</dd></div><div class="flex justify-between font-bold border-t border-[#E5E2DA] pt-3 mt-3"><dt>{{ 'gift.total' | t }}</dt><dd data-gift-value class="font-display text-[20px]">{{ gift_variant.price | money_with_currency }}</dd></div></dl><div class="bg-white border border-[#E5E2DA] p-5 mt-5 text-[#888] text-[13px] leading-relaxed">{{ 'gift.checkout_copy' | t }}</div>
    </div></aside>
  </div>
</section>
{% stylesheet %}.pm-gift-input{width:100%;border:1px solid #D0CCC4;background:white;padding:14px 16px;font-size:14px}.pm-gift-input:focus{border-color:#111}{% endstylesheet %}
<script src="{{ 'gift-card.js' | asset_url }}" defer="defer"></script>
{% schema %}
{
  "name": "Gift Card",
  "settings": [
    {"type":"number","id":"default_amount","label":"Default denomination (store currency)","default":50},
    {
      "type": "product",
      "id": "product",
      "label": "Shopify gift-card product"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Gift Card"
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Copy",
      "default": "Give someone more time for what matters. A Performance Meals gift card lets them choose their favourites."
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Gift Card"
    }
  ]
}
{% endschema %}
