{{ 'customer-stories.css' | asset_url | stylesheet_tag }}
<section class="customer-stories" aria-labelledby="Stories-{{ section.id }}">
  <div class="customer-stories__intro"><p>{{ section.settings.eyebrow | escape }}</p><h2 id="Stories-{{ section.id }}">{{ section.settings.heading | escape }}</h2><p>{{ section.settings.body | escape }}</p></div>
  <div class="customer-stories__grid">
  {% for block in section.blocks %}
    <article class="customer-stories__card" {{ block.shopify_attributes }}>
      <div class="customer-stories__photos{% if block.settings.second_photo != blank or block.settings.second_fallback != blank %} customer-stories__photos--pair{% endif %}">
        {% if block.settings.photo != blank %}{{ block.settings.photo | image_url: width: 1000 | image_tag: loading: 'lazy', alt: block.settings.photo_alt }}{% elsif block.settings.fallback_image != blank %}<img src="{{ block.settings.fallback_image | asset_url }}" alt="{{ block.settings.photo_alt | escape }}" width="800" height="1000" loading="lazy">{% endif %}
        {% if block.settings.second_photo != blank %}{{ block.settings.second_photo | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.second_alt }}{% elsif block.settings.second_fallback != blank %}<img src="{{ block.settings.second_fallback | asset_url }}" alt="{{ block.settings.second_alt | escape }}" width="800" height="1000" loading="lazy">{% endif %}
      </div>
      <div class="customer-stories__content"><p class="customer-stories__eyebrow">{{ block.settings.eyebrow | escape }}</p><h3>{{ block.settings.heading | escape }}</h3><p class="customer-stories__name">{{ block.settings.name | escape }}</p><p>{{ block.settings.body | escape }}</p>{% if block.settings.url != blank %}<a href="{{ block.settings.url }}">{{ block.settings.label | escape }} <span aria-hidden="true">→</span></a>{% endif %}</div>
    </article>
  {% endfor %}
  </div>
  <p class="customer-stories__note">{{ section.settings.note | escape }}</p>
</section>
{% schema %}
{
  "name": "Customer stories",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Introduction"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Results note",
      "default": "Individual experiences; results vary."
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Approved customer story",
      "settings": [
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "fallback_image",
          "label": "Theme photo filename"
        },
        {
          "type": "text",
          "id": "photo_alt",
          "label": "Photo description"
        },
        {
          "type": "image_picker",
          "id": "second_photo",
          "label": "Second photo"
        },
        {
          "type": "text",
          "id": "second_fallback",
          "label": "Second theme photo filename"
        },
        {
          "type": "text",
          "id": "second_alt",
          "label": "Second photo description"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Story"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer stories"
    }
  ]
}
{% endschema %}
