<section class="bg-[#FAF9F6] min-h-[60vh] px-6 py-16 sm:py-24"><div class="max-w-[900px] mx-auto"><h1 class="font-display text-[38px] sm:text-[56px] font-extrabold leading-tight mb-8">{{ page.title | escape }}</h1><div class="pm-richtext">{{ page.content }}</div>{% for block in section.blocks %}{% render block %}{% endfor %}</div></section>
{% schema %}
{
  "name": "Page",
  "settings": [],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Page"
    }
  ]
}
{% endschema %}
