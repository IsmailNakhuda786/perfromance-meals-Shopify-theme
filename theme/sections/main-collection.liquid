      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "require_subscription_account",
      "label": "Show sign-in for subscriptions",
      "default": true
    },
    {
      "type": "richtext",
      "id": "subscription_description",
      "label": "Approved subscription terms and benefits"
    },
    {
      "type": "url",
      "id": "overview_url",
      "label": "Ready Series overview"
    },
    {
      "type": "text",
      "id": "benefits_eyebrow",
      "label": "Benefits eyebrow",
      "default": "Why Ready Series"
    },
    {
      "type": "textarea",
      "id": "benefits_heading",
      "label": "Benefits heading",
      "default": "A busy day does not have\nto knock you off track"
    },
    {
      "type": "text",
      "id": "benefit_icon_1",
      "label": "Benefit 1 icon",
      "default": "\ud83e\uddca"
    },
    {
      "type": "text",
      "id": "benefit_title_1",
      "label": "Benefit 1 title",
      "default": "Frozen at peak"
    },
    {
      "type": "text",
      "id": "benefit_copy_1",
      "label": "Benefit 1 copy",
      "default": "Locked in at maximum freshness and nutrition."
    },
    {
      "type": "text",
      "id": "benefit_icon_2",
      "label": "Benefit 2 icon",
      "default": "\u23f1"
    },
    {
      "type": "text",
      "id": "benefit_title_2",
      "label": "Benefit 2 title",
      "default": "3-minute prep"
    },
    {
      "type": "text",
      "id": "benefit_copy_2",
      "label": "Benefit 2 copy",
      "default": "Microwave from frozen. No thaw time needed."
    },
    {
      "type": "text",
      "id": "benefit_icon_3",
      "label": "Benefit 3 icon",
      "default": "\ud83d\udcca"
    },
    {
      "type": "text",
      "id": "benefit_title_3",
      "label": "Benefit 3 title",
      "default": "Macro tracked"
    },
    {
      "type": "text",
      "id": "benefit_copy_3",
      "label": "Benefit 3 copy",
      "default": "Every gram counted. No guesswork required."
    },
    {
      "type": "number",
      "id": "delivery_threshold",
      "label": "Approved free delivery threshold (currency minor units)",
      "default": 12000
    },
    {
      "type": "number",
      "id": "delivery_fee",
      "label": "Approved delivery fee below threshold (currency minor units)",
      "default": 1000
    },
    {
      "type": "paragraph",
      "content": "Presentation only. Keep these approved delivery messages aligned with native Shopify shipping rates; they do not set checkout rates."
    },
    {
      "type": "textarea",
      "id": "benefits_description",
      "label": "Benefits introduction",
      "default": "Proper meals without the planning spiral. Keep a dependable option ready, see exactly what you are eating, and stay moving when the day changes."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Single meal category",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Exact performance.category filter value"
        }
      ]
    },
    {
      "type": "promo",
      "name": "Active discount message",
      "settings": [
        {
          "type": "text",
          "id": "code",
          "label": "Existing Shopify discount code"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Approved discount description"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Ready Series collection"
    }
  ]
}
{% endschema %}
